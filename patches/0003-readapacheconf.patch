From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: litehttpd <noreply@web.casa>
Date: Sat, 05 Apr 2026 20:00:00 +0800
Subject: [PATCH 3/4] litehttpd: add readApacheConf startup directive

Adds a readApacheConf directive to httpd_config.conf that runs
litehttpd-confconv at OLS startup to convert an Apache httpd.conf
into native OLS configuration (listeners, vhosts, contexts).

Usage in /usr/local/lsws/conf/httpd_config.conf:

  readApacheConf /etc/httpd/conf/httpd.conf portmap=80:8088,443:8443

Implementation follows the same pattern as the existing 'include'
directive in plainconf::loadConfFile(): intercept the keyword before
parseLine(), fork/exec the external converter, then loadConfFile()
the generated output directory.

Modeled after CyberPanel's embedded readApacheConf, but uses an
external converter binary instead of a built-in Apache parser —
cleaner separation, independently updatable.

Security: uses fork()+execv() (not system()) to prevent shell injection.
The confconv binary path is derived from SERVERROOT/bin/, not PATH.
---
 src/main/plainconf.cpp | 100 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 100 insertions(+)

diff --git a/src/main/plainconf.cpp b/src/main/plainconf.cpp
--- a/src/main/plainconf.cpp
+++ b/src/main/plainconf.cpp
@@ -38,6 +38,7 @@
 #include <sys/stat.h>
 #include <sys/types.h>
 #include <unistd.h>
+#include <sys/wait.h>
 #include "mainserverconfig.h"

 //#define TEST_OUTPUT_PLAIN_CONF
@@ -1482,6 +1483,105 @@
                 free(pathc);
                 loadConfFile(achBuf);
             }
+            else if (strncasecmp(p, "readapacheconf", 14) == 0
+                     && (p[14] == ' ' || p[14] == '\t'))
+            {
+                /* litehttpd: readApacheConf /path/to/httpd.conf [opts...]
+                 * Runs litehttpd-confconv at startup to convert Apache config
+                 * to OLS native format, then loads the generated output.
+                 * Modeled after CyberPanel's embedded readApacheConf, but
+                 * uses external converter — cleaner separation. */
+                const char *ra = p + 14;
+                while (*ra == ' ' || *ra == '\t') ra++;
+                if (*ra)
+                {
+                    /* Split: first token = Apache config path, rest = options */
+                    char apachePath[4096] = {0};
+                    char extraOpts[4096] = {0};
+                    const char *sp = ra;
+                    while (*sp && *sp != ' ' && *sp != '\t') sp++;
+                    size_t pLen = (size_t)(sp - ra);
+                    if (pLen >= sizeof(apachePath)) pLen = sizeof(apachePath) - 1;
+                    memcpy(apachePath, ra, pLen);
+                    while (*sp == ' ' || *sp == '\t') sp++;
+                    if (*sp)
+                        lstrncpy(extraOpts, sp, sizeof(extraOpts));
+
+                    /* Build paths relative to SERVERROOT */
+                    char confconvBin[4096];
+                    char outputDir[4096];
+                    snprintf(confconvBin, sizeof(confconvBin),
+                             "%s/bin/litehttpd-confconv", rootPath.c_str());
+                    snprintf(outputDir, sizeof(outputDir),
+                             "%s/conf/apacheconf", rootPath.c_str());
+
+                    struct stat stBuf;
+                    if (stat(confconvBin, &stBuf) != 0)
+                    {
+                        logToMem(LOG_LEVEL_ERR,
+                            "readApacheConf: converter not found: %s",
+                            confconvBin);
+                    }
+                    else if (stat(apachePath, &stBuf) != 0)
+                    {
+                        logToMem(LOG_LEVEL_ERR,
+                            "readApacheConf: Apache config not found: %s",
+                            apachePath);
+                    }
+                    else
+                    {
+                        mkdir(outputDir, 0755);
+                        logToMem(LOG_LEVEL_INFO,
+                            "readApacheConf: converting %s -> %s/ %s",
+                            apachePath, outputDir, extraOpts);
+
+                        /* fork + execv: no shell, safe from injection */
+                        const char *argv[8];
+                        int ai = 0;
+                        argv[ai++] = confconvBin;
+                        argv[ai++] = "--input";
+                        argv[ai++] = apachePath;
+                        argv[ai++] = "--output";
+                        argv[ai++] = outputDir;
+                        if (extraOpts[0])
+                            argv[ai++] = extraOpts;
+                        argv[ai] = NULL;
+
+                        pid_t pid = fork();
+                        if (pid == 0)
+                        {
+                            execv(confconvBin, (char *const *)argv);
+                            _exit(127);
+                        }
+                        else if (pid > 0)
+                        {
+                            int wstat = 0;
+                            waitpid(pid, &wstat, 0);
+                            if (WIFEXITED(wstat) && WEXITSTATUS(wstat) == 0)
+                            {
+                                logToMem(LOG_LEVEL_INFO,
+                                    "readApacheConf: OK, loading %s/",
+                                    outputDir);
+                                loadConfFile(outputDir);
+                            }
+                            else
+                                logToMem(LOG_LEVEL_ERR,
+                                    "readApacheConf: converter failed"
+                                    " (exit=%d)",
+                                    WIFEXITED(wstat) ?
+                                        WEXITSTATUS(wstat) : -1);
+                        }
+                        else
+                            logToMem(LOG_LEVEL_ERR,
+                                "readApacheConf: fork failed: %s",
+                                strerror(errno));
+                    }
+                }
+                else
+                    logToMem(LOG_LEVEL_ERR,
+                        "readApacheConf: missing config path in %s:%d",
+                        path, lineNumber);
+            }
             else
             {
                 nMultiLineModeSignLen = checkMultiLineMode(p, sMultiLineModeSign,
--
2.40.0
